;; ---- transients (ticks / pulses): the strike, latched -----------------------
(def xt (max 0 (- T x-t0)))
(def xse (exp (* (- 0 xt) x-itau)))
(def xm (* x-amp (exp (* (- 0 xt) x-idec)) (- 1 (exp (* (- 0 xt) x-irise))) (- 1 (* x-mgb (- 1 GB)))
          (sin (+ (* twopi fmul (+ (* x-f xt) (* x-sh x-tau (- 1 xse)))) x-ph))))
(def trans (sum xm))
(def trans-msm (sum (* x-msm xm)))
(def modal (+ bank trans))

;; ---- growl (one gliding clipped sine, 35 Hz) --------------------------------
(def gr-shift (max -31.5 (* g-bendE p-gr_dl)))
(def gr-settle (exp (/ (- 0 T) p-gr_tau)))
(def gr-ph (+ (* twopi fmul (+ (* 35 T) (* gr-shift p-gr_tau (- 1 gr-settle)))) p-gr_off))
(def gr-hz (* fmul (+ 35 (* gr-shift gr-settle))))
(def gr-aud (clip (/ (- (* 0.02 samplerate) gr-hz) (* 0.008 samplerate)) 0 1))
(def gr-sin (sin gr-ph))
(def gr-wave (- (clip gr-sin -1 p-gr_clip) (+ p-gr_a (* p-gr_b gr-sin))))
(def gr-env (* (+ (* 0.5 (exp (/ (- 0 T) (* g-decay p-gr_d1)))) (* 0.5 (exp (/ (- 0 T) (* g-decay p-gr_d2)))))
              (- 1 (exp (/ (- 0 T) (* g-attack 0.004))))))
(def growl (* g-body g-growl p-gr_amp gr-aud gr-env gr-wave))

;; ---- burst ------------------------------------------------------------------
(def bu-dt (- (mix age (* age g-tuning) p-bu_samp) p-bu_tc))
(def bu-z (/ bu-dt p-bu_w))
(def bu-g (exp (* -0.5 (min 60 (* bu-z bu-z)))))
(def bu-h (- 0.5 (* 0.5 (cos (* twopi (clip bu-z 0 1))))))
(def burst (* g-tickE p-bu_amp (mix bu-g bu-h p-bu_hann) (sin (+ (* twopi p-bu_f bu-dt) p-bu_off))))

(def bank-all (+ modal growl burst))
(def bank-sh (+ bank-msm trans-msm (* p-bu_sm burst)))

;; ---- body shaper, bark, 18 Hz body HP ---------------------------------------
(def xin (* g-vpreE bank-sh))
(def xcl (clip xin (- 0 p-sh_ecl) p-sh_ecl))
(def sh-even (* g-shape (- (* xcl xcl (+ p-sh_ec (* xcl (+ p-sh_p3 (* xcl (+ p-sh_p4 (* xcl p-sh_p5)))))))
                           (* p-sh_ec p-sh_ed g-vpreE g-vpreE 0.5 bank-dc))))
(def sh-odd (* g-shape p-sh_oc (- (* p-sh_ow (tanh (/ xin p-sh_ow))) xin)))
(def sh-y0 (+ xin sh-even sh-odd))
(def sh-y1 (mix sh-y0 (* (sign sh-y0) (rat-side (abs sh-y0) (/ 1 (max 0.000001 (* p-sh_rg g-shape))) 4)) p-sh_rk))
(def sat-gain (max 0.01 (* p-sat_g (mix 1 g-shape p-sat_on))))
(def sat-ref (tanh p-sat_b))
(def sat-norm (/ 0.8 (- (tanh (+ (* 0.8 sat-gain) p-sat_b)) sat-ref)))
(def shaped (mix sh-y1 (* sat-norm (- (tanh (+ (* sat-gain sh-y1) p-sat_b)) sat-ref)) p-sat_on))
(def bark (* g-shape p-bk_amt (sqrt g-vel) (clip (/ (- T p-bk_del) 0.012) 0 1)
            (biquad (tanh (+ (* 8 bank-all) 0.3)) 300 0.707 1 1)))
(def body-raw (+ (* g-vpreE (+ (- bank-all bank-sh) bark)) shaped))
(make-history bh_s1)
(make-history bh_s2)
(def bh-g (tan (/ (* 3.14159265358979 18) samplerate)))
(def bh-a1 (/ 1 (+ 1 (* bh-g (+ bh-g 1.414213562)))))
(def bh-a2 (* bh-g bh-a1))
(def bh-a3 (* bh-g bh-a2))
(def bh-ic1 (gswitch hit 0 (read-history bh_s1)))
(def bh-ic2 (gswitch hit 0 (read-history bh_s2)))
(def bh-v3 (- body-raw bh-ic2))
(def bh-v1 (+ (* bh-a1 bh-ic1) (* bh-a2 bh-v3)))
(def bh-v2 (+ bh-ic2 (* bh-a2 bh-ic1) (* bh-a3 bh-v3)))
(write-history bh_s1 (- (* 2 bh-v1) bh-ic1))
(write-history bh_s2 (- (* 2 bh-v2) bh-ic2))
(def body (mix body-raw (- body-raw (* 1.414213562 bh-v1) bh-v2) p-bhp_on))

;; ---- {NB}-band noise (+{NBP - NB} silent dummies for 4-wide SIMD) + hum on ONE xorshift white ----
(def u0 (noise))
(def white (* 3.4641016 (- u0 0.5)))
(def band-fc {tlit(L.BAND_FC + [1000.0] * (NBP - NB))})
(def band-w0 (/ (* twopi band-fc) samplerate))
(def band-alpha (/ (sin band-w0) {fmt(2 * L.BAND_Q)}))
(def band-b0 (/ band-alpha (+ 1 band-alpha)))
(def band-a1 (/ (* -2 (cos band-w0)) (+ 1 band-alpha)))
(def band-a2 (/ (- 1 band-alpha) (+ 1 band-alpha)))
(def band-norm (gswitch (lt samplerate 46050) {nt[44100.0]}
                 (gswitch (lt samplerate 68100) {nt[48000.0]}
                   (gswitch (lt samplerate 92100) {nt[88200.0]} {nt[96000.0]}))))
(make-history nx1)
(make-history nx2)
(def white-x2 (read-history nx2))
(write-history nx2 (read-history nx1))
(write-history nx1 white)
(make-tensor-history s1y1 @shape [1 {NBP}])
(make-tensor-history s1y2 @shape [1 {NBP}])
(make-tensor-history s2y1 @shape [1 {NBP}])
(make-tensor-history s2y2 @shape [1 {NBP}])
(def s1-1 (read-tensor-history s1y1))
(def s1-2 (read-tensor-history s1y2))
(def s2-1 (read-tensor-history s2y1))
(def s2-2 (read-tensor-history s2y2))
(def stage1 (- (* band-b0 (- white white-x2)) (+ (* band-a1 s1-1) (* band-a2 s1-2))))
(def stage2 (- (* band-b0 (- stage1 s1-2)) (+ (* band-a1 s2-1) (* band-a2 s2-2))))
(write-tensor-history s1y2 s1-1)
(write-tensor-history s1y1 stage1)
(write-tensor-history s2y2 s2-1)
(write-tensor-history s2y1 stage2)
(def bands (* band-norm stage2))
(def n-t (max 0 (- (mix age (* age g-tuning) p-nsamp) p-noise_onset)))
(def n-att (- 1 (exp (/ (- 0 n-t) p-noise_rise))))
(def n-gate (* (vpow GA p-noise_ga) (vpow GB p-noise_gb)))
(def c-gate (vpow GA p-couple_ga))
;; band decay corrections like the slots': the fast stage is e^-(u^q) with u = integral of 1/d1(t) dt
;; (u = t / d1 on a static hit), the slow stage e^-(t/d2 + Ls)
(make-history nt-h)
(def n-dt (gswitch hit 0 (- n-t (read-history nt-h))))
(write-history nt-h n-t)
(make-tensor-history nLf @shape [1 {NBP}])
(make-tensor-history nLs @shape [1 {NBP}])
(def n-Lf (gswitch hit 0 (+ (read-tensor-history nLf) (* n-dt (- L-id1 n-id1)))))
(def n-Ls (gswitch hit 0 (+ (read-tensor-history nLs) (* n-dt (- L-id2 n-id2)))))
(write-tensor-history nLf n-Lf)
(write-tensor-history nLs n-Ls)
(def band-env (+ (* n-gate n-att (+ (* n-fast (exp (- 0 (exp (* p-noise_q (log (max (+ (* n-t n-id1) n-Lf) 0.000000000000000000000000000001)))))) n-fc) (* n-slow (exp (- (* (- 0 n-t) n-id2) n-Ls)) n-sc)))
                 (* c-gate n-cpl (sqrt (+ bank-esq 0.0000000001)))))
(def hum-nz (biquad (* (- (* u0 2) 1) (sqrt (/ samplerate 16000))) 12 0.707 1 0))
(def hum-s (sin (* twopi g-tuning 92 age)))
(def hum (* g-hvel (- 1 (exp (/ (- 0 age) 0.1))) (exp (/ (- 0 age) 0.22)) (+ hum-s (* p-hum_h2 (- 1 (* 2 hum-s hum-s)))) hum-nz))
(def tex (* g-vpreE g-vtexE (+ (* g-nvel (sum (* band-env bands))) (* n-gate hum))))
(def source (+ body (* (- 1 p-np) tex)))

;; ---- recording chain ----------------------------------------------------------
(def ceil-p g-ceil)
(def ceil-n (* ceil-p p-cneg))
(def cx (+ source p-coff))
(def c-up (gte cx 0))
(def c-mag (abs cx))
(def c-cs (mix ceil-n ceil-p c-up))
(def c-ka (mix p-kan p-kap c-up))
(def c-kb (mix p-kbn p-kbp c-up))
(def c-side (mix (knee-side c-mag (* c-ka c-cs) (max 0.000001 (* c-kb c-cs))) (rat-side c-mag c-cs p-kn) p-kr))
(def clipped (- (* (- (* 2 c-up) 1) c-side) p-coff))
(def recorded (mix (* g-dry source) clipped g-cmix))
(make-history dc_x)
(make-history dc_y)
(def dc-r (- 1 (/ (* 6.283185307 p-dc_hz) samplerate)))
(def dc-px (gswitch hit 0 (read-history dc_x)))
(def dc-py (gswitch hit 0 (read-history dc_y)))
(def dcd (+ (- recorded dc-px) (* dc-r dc-py)))
(write-history dc_x recorded)
(write-history dc_y dcd)
(def rl1 (reset-lp2 dcd p-rl_hz p-rl_q1 hit))
(def rl2 (reset-lp2 rl1 p-rl_hz p-rl_q2 hit))
(def rec-lp (mix dcd (mix rl1 rl2 p-rl_two) p-rl_mix))
(def with-post (+ rec-lp (* p-np tex)))
(def split (min (* 180 (mix 1 g-tuning p-dr_track)) (* 0.2 samplerate)))
(def upper (biquad with-post split 0.707 1 1))
(def colour (biquad (* (/ (- g-drive 1) 4) (- (/ (tanh (* g-drive upper)) (sqrt g-drive)) upper)) split 0.707 1 1))
(def limited (+ with-post colour))
