;; Latent Kick Morph panel (the Latent Snare Morph layout). One map of the latent
;; space (z1 across, z2 up, ring size z3; the 33 VILLAIN kicks at their learned
;; codes) with two rings: START is where the hit strikes (z1..z4), END is where it
;; rings out to (b1..b4); the faint line between them is the morph path. Drag a
;; ring to move it (one undo step per drag); a press on empty space moves the
;; selected ring there. Clicking a ring selects it; a short click on a kick loads
;; its whole 4-D code into the selected ring. The off-map dims (z3, z4) are the
;; knobs under START / END. The strips under the map are each ring's nearest kick.
;; MORPH sets how the ringing hit travels from START to END; TONE is the global
;; knobs (VILLAIN's tune ratio, decay, drive, level). One accent, flat panels.
;; Generated by ModalKickAD/scripts/morph/build_stage.py.
(def lkm-accent () (eseq.effects.custom-ui-lego/ui-accent-cyan))
(def lkm-surf () :instrument-group-bg)
;; END's ring, badge and strip: the neutral foreground, so START keeps the one accent.
(def lkm-end-color () :fg)

@@CODES@@

;; Per-panel UI state: which ring (0 START, 1 END) a kick click loads into.
(defstate lkm-ui-state '())

(def lkm-state-get (key fallback)
  (let ((scope-name (eseq.effects.custom-ui-runtime/custom-ui-scope-name)))
    (let ((entry (nth (filter |item| (= (get item :scope) scope-name) lkm-ui-state) 0)))
      (if (and entry (get entry key)) (get entry key) fallback))))

(def lkm-state-set-in (scope-name key value)
  (let ((entry (nth (filter |item| (= (get item :scope) scope-name) lkm-ui-state) 0)))
    (set! lkm-ui-state
      (cons
        (merge (if entry entry (dict :scope scope-name)) key value)
        (filter |item| (not (= (get item :scope) scope-name)) lkm-ui-state)))))

(def lkm-selected () (lkm-state-get :selected 0))

(def lkm-gap () (eseq.effects.custom-ui-lego/ui-lego-gap))
(def lkm-dense-h () (eseq.effects.custom-ui-lego/ui-lego-dense-h))
(def lkm-tall-h () (+ (lkm-dense-h) (eseq.effects.custom-ui-lego/ui-lego-small-h) (lkm-gap)))
(def lkm-total-h () (+ (lkm-dense-h) (lkm-tall-h) (lkm-gap)))
(def lkm-half-h () (* 0.5 (- (lkm-total-h) (lkm-gap))))
(def lkm-side-w () 12.4)
(def lkm-map-w () 44.0)
(def lkm-right-w () 25.0)

(def lkm-param (name) (eseq.effects.custom-ui-runtime/custom-ui-current-param name))

(def lkm-effective (name fallback)
  (let ((p (lkm-param name)))
    (if p (eseq.effects.param-controls/param-effective-value p) fallback)))

;; a latent coordinate as the decoder sees it: effective value, clipped to [-3, 3]
(def lkm-z (name) (min 3 (max -3 (lkm-effective name 0))))

(def lkm-sq (x) (* x x))

;; side = "z" (START) or "b" (END): the four param names of that side
(def lkm-names (side) (list (str side "1") (str side "2") (str side "3") (str side "4")))

;; marker id 0 = START (z), 1 = END (b)
(def lkm-side-of (id) (if (= id 1) "b" "z"))

;; Index of the kick whose 4-D code is nearest to that side's point.
(def lkm-nearest (side)
  (let ((n (lkm-names side)) (codes (lkm-codes)))
    (let ((v1 (lkm-z (nth n 0))) (v2 (lkm-z (nth n 1))) (v3 (lkm-z (nth n 2))) (v4 (lkm-z (nth n 3))))
      (nth
        (reduce |acc i|
          (let ((c (nth codes i)))
            (let ((d (+ (lkm-sq (- (nth c 1) v1)) (lkm-sq (- (nth c 2) v2))
                        (lkm-sq (- (nth c 3) v3)) (lkm-sq (- (nth c 4) v4)))))
              (if (< d (nth acc 1)) (list i d) acc)))
          (list 0 1000000)
          (range (len codes)))
        0))))

;; A kick click loads its code into the side's four params, as one
;; committed param batch (one undo step).
(def lkm-load-code (scope side index)
  (let ((c (nth (lkm-codes) index)) (n (lkm-names side)))
    (eseq.effects.custom-ui-runtime/custom-ui-set-envelope-in-scope scope
      (list (list :p1 (nth n 0)) (list :p2 (nth n 1)) (list :p3 (nth n 2)) (list :p4 (nth n 3)))
      (dict :p1 (nth c 1) :p2 (nth c 2) :p3 (nth c 3) :p4 (nth c 4) :active false))))

;; A ring drag writes that side's two map dims as one coalesced gesture.
(def lkm-move (scope side x y phase)
  (eseq.effects.custom-ui-runtime/custom-ui-set-envelope-in-scope scope
    (list (list :x (str side "1")) (list :y (str side "2")))
    (dict :x x :y y :active (< phase 2))))

(def lkm-panel (section width height body)
  (box :width width :height height :padding 0.18
    :background-color (lkm-surf)
    :on-click (eseq.effects.custom-ui-sections/ui-section-select-callback section)
    body))

(def lkm-marker (id side label near)
  (dict :id id :label label :near near
    :x (lkm-z (str side "1")) :y (lkm-z (str side "2")) :size (lkm-z (str side "3"))))

;; The one latent map: START and END rings at their (dim 1, dim 2), sized by
;; dim 3, each with a dashed lead from its nearest kick, whose envelopes are
;; the two strips under the map.
(def lkm-map (near-a near-b)
  (let ((scope (eseq.effects.custom-ui-runtime/custom-ui-current-scope))
        (scope-name (eseq.effects.custom-ui-runtime/custom-ui-scope-name)))
    (box :width (lkm-map-w) :height (lkm-total-h) :corner-radius 12 :padding 0.18
      :background-color (lkm-surf)
      (family-map
        :file (lkm-family-file)
        :markers (list (lkm-marker 0 "z" "START" near-a) (lkm-marker 1 "b" "END" near-b))
        :selected (lkm-selected)
        :accent (lkm-accent)
        :b-color (lkm-end-color)
        :dot-color :curve-editor-fg
        :background-color :curve-editor-bg
        :grid-color :curve-editor-grid
        :label-color :curve-editor-fg
        :line-color :curve-editor-fg
        :x-label "z1" :y-label "z2"
        :width (- (lkm-map-w) 0.4) :height (- (lkm-total-h) 0.4)
        :on-pick (lambda (index id) (lkm-load-code scope (lkm-side-of id) index))
        :on-move (lambda (x y phase id)
          (do
            (if (= phase 0) (lkm-state-set-in scope-name :selected id) nil)
            (lkm-move scope (lkm-side-of id) x y phase)))))))

;; START / END: badge (accent / neutral), then that side's two off-map dims.
(def lkm-depth (section side title color)
  (lkm-panel section (lkm-side-w) (lkm-half-h)
    (v-stack :width :fill :height :fill :gap 0.20 :align :start
      (eseq.effects.custom-ui-lego/ui-lego-section-badge-s section title 4.2 color)
      (h-stack :width :fill :gap 0.30 :align :start
        (eseq.effects.custom-ui-lego/ui-lego-knob-full-s section (str side "3") (str side "3") 5.6 color 2)
        (eseq.effects.custom-ui-lego/ui-lego-knob-full-s section (str side "4") (str side "4") 5.6 color 2)))))

(def lkm-morph-block ()
  (lkm-panel 4 (lkm-right-w) (lkm-dense-h)
    (h-stack :width :fill :height :fill :gap 0.10 :align :start
      (eseq.effects.custom-ui-lego/ui-lego-section-badge-s 4 "MORPH" 4.4 (lkm-accent))
      (eseq.effects.custom-ui-lego/ui-lego-knob-taper-sized-s 4 "morph" "time" 4.6
        (eseq.effects.custom-ui-lego/ui-lego-knob-full-h) (eseq.effects.custom-ui-lego/ui-lego-knob-full-h) (lkm-accent) 0 "log")
      (eseq.effects.custom-ui-lego/ui-lego-knob-sized-s 4 "curve" "curve" 4.6
        (eseq.effects.custom-ui-lego/ui-lego-knob-full-h) (eseq.effects.custom-ui-lego/ui-lego-knob-full-h) (lkm-accent) 2)
      (eseq.effects.custom-ui-lego/ui-lego-knob-sized-s 4 "amount" "amount" 4.6
        (eseq.effects.custom-ui-lego/ui-lego-knob-full-h) (eseq.effects.custom-ui-lego/ui-lego-knob-full-h) (lkm-accent) 2)
      (eseq.effects.custom-ui-lego/ui-lego-knob-sized-s 4 "follow" "follow" 4.6
        (eseq.effects.custom-ui-lego/ui-lego-knob-full-h) (eseq.effects.custom-ui-lego/ui-lego-knob-full-h) (lkm-accent) 2))))

(def lkm-tone-block ()
  (lkm-panel 5 (lkm-right-w) (lkm-tall-h)
    (v-stack :width :fill :height :fill :gap 0.20 :align :start
      (eseq.effects.custom-ui-lego/ui-lego-section-badge-s 5 "TONE" 4.0 (lkm-accent))
      (h-stack :width :fill :gap 0.30 :align :start
        (eseq.effects.custom-ui-lego/ui-lego-knob-full-s 5 "tune" "tune" 5.2 (lkm-accent) 2)
        (eseq.effects.custom-ui-lego/ui-lego-knob-full-s 5 "decay" "decay" 5.2 (lkm-accent) 2)
        (eseq.effects.custom-ui-lego/ui-lego-knob-full-s 5 "drive" "drive" 5.2 (lkm-accent) 2)
        (eseq.effects.custom-ui-lego/ui-lego-knob-full-s 5 "level" "level" 5.2 (lkm-accent) 2)))))

(defsynth-ui
  (let ((near-a (lkm-nearest "z")) (near-b (lkm-nearest "b")))
    (h-stack :width :fill :gap 0.05 :align :stretch :debug-name "lkm-surface"
      (v-stack :width (lkm-side-w) :gap (lkm-gap)
        (lkm-depth 0 "z" "START" (lkm-accent))
        (lkm-depth 3 "b" "END" (lkm-end-color)))
      (lkm-map near-a near-b)
      (v-stack :width (lkm-right-w) :gap (lkm-gap)
        (lkm-morph-block)
        (lkm-tone-block)))))
