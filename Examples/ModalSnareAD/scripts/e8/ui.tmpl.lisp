;; Latent Snare Morph panel. One map of the latent space (two latent dims as axes,
;; the 32 VILLAIN snares at their learned codes) with two rings: START is where
;; the hit strikes (z1..z4), END is where it rings out to (b1..b4); the faint line
;; between them is the morph path. Drag a ring to move it (one undo step per
;; drag); a press on empty space moves the selected ring there. Clicking a ring
;; selects it; a short click on a snare loads its whole 4-D code into the
;; selected ring (Shift: the other one). The off-map dims are the knobs under
;; START / END. The strips under the map are each ring's nearest snare. MORPH
;; sets how the ringing hit travels from START to END; TONE is the post-decoder
;; knobs. One accent, flat panels. Generated by scripts/e8/build_stage.py (codes block
;; from the installed Latent Snare panel).
(def lm-accent () (eseq.effects.custom-ui-lego/ui-accent-cyan))
(def lm-surf () :instrument-group-bg)
;; END's ring, badge and strip: the neutral foreground, so START keeps the one accent.
(def lm-end-color () :fg)

@@CODES@@

;; Per-panel UI state: which ring (0 START, 1 END) a snare click loads into.
(defstate lm-ui-state '())

(def lm-state-get (key fallback)
  (let ((scope-name (eseq.effects.custom-ui-runtime/custom-ui-scope-name)))
    (let ((entry (nth (filter |item| (= (get item :scope) scope-name) lm-ui-state) 0)))
      (if (and entry (get entry key)) (get entry key) fallback))))

(def lm-state-set-in (scope-name key value)
  (let ((entry (nth (filter |item| (= (get item :scope) scope-name) lm-ui-state) 0)))
    (set! lm-ui-state
      (cons
        (merge (if entry entry (dict :scope scope-name)) key value)
        (filter |item| (not (= (get item :scope) scope-name)) lm-ui-state)))))

(def lm-selected () (lm-state-get :selected 0))

(def lm-gap () (eseq.effects.custom-ui-lego/ui-lego-gap))
(def lm-dense-h () (eseq.effects.custom-ui-lego/ui-lego-dense-h))
(def lm-tall-h () (+ (lm-dense-h) (eseq.effects.custom-ui-lego/ui-lego-small-h) (lm-gap)))
(def lm-total-h () (+ (lm-dense-h) (lm-tall-h) (lm-gap)))
(def lm-half-h () (* 0.5 (- (lm-total-h) (lm-gap))))
(def lm-side-w () 12.4)
(def lm-map-w () 44.0)
(def lm-right-w () 25.0)

(def lm-param (name) (eseq.effects.custom-ui-runtime/custom-ui-current-param name))

(def lm-effective (name fallback)
  (let ((p (lm-param name)))
    (if p (eseq.effects.param-controls/param-effective-value p) fallback)))

;; a latent coordinate as the decoder sees it: effective value, clipped to [-3, 3]
(def lm-z (name) (min 3 (max -3 (lm-effective name 0))))

(def lm-sq (x) (* x x))

;; side = "z" (START) or "b" (END): the four param names of that side
(def lm-names (side) (list (str side "1") (str side "2") (str side "3") (str side "4")))

;; marker id 0 = START (z), 1 = END (b)
(def lm-side-of (id) (if (= id 1) "b" "z"))

;; Index of the snare whose 4-D code is nearest to that side's point.
(def lm-nearest (side)
  (let ((n (lm-names side)) (codes (ls-codes)))
    (let ((v1 (lm-z (nth n 0))) (v2 (lm-z (nth n 1))) (v3 (lm-z (nth n 2))) (v4 (lm-z (nth n 3))))
      (nth
        (reduce |acc i|
          (let ((c (nth codes i)))
            (let ((d (+ (lm-sq (- (nth c 1) v1)) (lm-sq (- (nth c 2) v2))
                        (lm-sq (- (nth c 3) v3)) (lm-sq (- (nth c 4) v4)))))
              (if (< d (nth acc 1)) (list i d) acc)))
          (list 0 1000000)
          (range (len codes)))
        0))))

;; A snare click loads its code into the side's four params, as one
;; committed param batch (one undo step).
(def lm-load-code (scope side index)
  (let ((c (nth (ls-codes) index)) (n (lm-names side)))
    (eseq.effects.custom-ui-runtime/custom-ui-set-envelope-in-scope scope
      (list (list :p1 (nth n 0)) (list :p2 (nth n 1)) (list :p3 (nth n 2)) (list :p4 (nth n 3)))
      (dict :p1 (nth c 1) :p2 (nth c 2) :p3 (nth c 3) :p4 (nth c 4) :active false))))

;; A ring drag writes that side's two map dims as one coalesced gesture.
(def lm-move (scope side x y phase)
  (eseq.effects.custom-ui-runtime/custom-ui-set-envelope-in-scope scope
    (list (list :x (str side "1")) (list :y (str side "3")))
    (dict :x x :y y :active (< phase 2))))

(def lm-panel (section width height body)
  (box :width width :height height :padding 0.18
    :background-color (lm-surf)
    :on-click (eseq.effects.custom-ui-sections/ui-section-select-callback section)
    body))

(def lm-marker (id side label near)
  (dict :id id :label label :near near
    :x (lm-z (str side "1")) :y (lm-z (str side "3")) :size (lm-z (str side "2"))))

;; The one latent map: START and END rings at their (dim 1, dim 3), sized by
;; dim 2, each with a dashed lead from its nearest snare, whose envelopes are
;; the two strips under the map.
(def lm-map (near-a near-b)
  (let ((scope (eseq.effects.custom-ui-runtime/custom-ui-current-scope))
        (scope-name (eseq.effects.custom-ui-runtime/custom-ui-scope-name)))
    (box :width (lm-map-w) :height (lm-total-h) :corner-radius 12 :padding 0.18
      :background-color (lm-surf)
      (family-map
        :file (ls-family-file)
        :markers (list (lm-marker 0 "z" "START" near-a) (lm-marker 1 "b" "END" near-b))
        :selected (lm-selected)
        :accent (lm-accent)
        :b-color (lm-end-color)
        :dot-color :curve-editor-fg
        :background-color :curve-editor-bg
        :grid-color :curve-editor-grid
        :label-color :curve-editor-fg
        :line-color :curve-editor-fg
        :x-label "z1" :y-label "z3"
        :width (- (lm-map-w) 0.4) :height (- (lm-total-h) 0.4)
        :on-pick (lambda (index id) (lm-load-code scope (lm-side-of id) index))
        :on-move (lambda (x y phase id)
          (do
            (if (= phase 0) (lm-state-set-in scope-name :selected id) nil)
            (lm-move scope (lm-side-of id) x y phase)))))))

;; START / END: badge (accent / neutral), then that side's two off-map dims.
(def lm-depth (section side title color)
  (lm-panel section (lm-side-w) (lm-half-h)
    (v-stack :width :fill :height :fill :gap 0.20 :align :start
      (eseq.effects.custom-ui-lego/ui-lego-section-badge-s section title 4.2 color)
      (h-stack :width :fill :gap 0.30 :align :start
        (eseq.effects.custom-ui-lego/ui-lego-knob-full-s section (str side "2") (str side "2") 5.6 color 2)
        (eseq.effects.custom-ui-lego/ui-lego-knob-full-s section (str side "4") (str side "4") 5.6 color 2)))))

(def lm-morph-block ()
  (lm-panel 4 (lm-right-w) (lm-dense-h)
    (h-stack :width :fill :height :fill :gap 0.10 :align :start
      (eseq.effects.custom-ui-lego/ui-lego-section-badge-s 4 "MORPH" 4.4 (lm-accent))
      (eseq.effects.custom-ui-lego/ui-lego-knob-taper-sized-s 4 "morph" "time" 4.6
        (eseq.effects.custom-ui-lego/ui-lego-knob-full-h) (eseq.effects.custom-ui-lego/ui-lego-knob-full-h) (lm-accent) 0 "log")
      (eseq.effects.custom-ui-lego/ui-lego-knob-sized-s 4 "curve" "curve" 4.6
        (eseq.effects.custom-ui-lego/ui-lego-knob-full-h) (eseq.effects.custom-ui-lego/ui-lego-knob-full-h) (lm-accent) 2)
      (eseq.effects.custom-ui-lego/ui-lego-knob-sized-s 4 "amount" "amount" 4.6
        (eseq.effects.custom-ui-lego/ui-lego-knob-full-h) (eseq.effects.custom-ui-lego/ui-lego-knob-full-h) (lm-accent) 2)
      (eseq.effects.custom-ui-lego/ui-lego-knob-sized-s 4 "follow" "follow" 4.6
        (eseq.effects.custom-ui-lego/ui-lego-knob-full-h) (eseq.effects.custom-ui-lego/ui-lego-knob-full-h) (lm-accent) 2))))

(def lm-tone-block ()
  (lm-panel 5 (lm-right-w) (lm-tall-h)
    (v-stack :width :fill :height :fill :gap 0.20 :align :start
      (eseq.effects.custom-ui-lego/ui-lego-section-badge-s 5 "TONE" 4.0 (lm-accent))
      (h-stack :width :fill :gap 0.30 :align :start
        (eseq.effects.custom-ui-lego/ui-lego-knob-full-s 5 "tune" "tune" 6.2 (lm-accent) 1)
        (eseq.effects.custom-ui-lego/ui-lego-knob-full-s 5 "decay" "decay" 6.2 (lm-accent) 2)
        (eseq.effects.custom-ui-lego/ui-lego-knob-full-s 5 "level" "level" 6.2 (lm-accent) 2)))))

(defsynth-ui
  (let ((near-a (lm-nearest "z")) (near-b (lm-nearest "b")))
    (h-stack :width :fill :gap 0.05 :align :stretch :debug-name "lm-surface"
      (v-stack :width (lm-side-w) :gap (lm-gap)
        (lm-depth 0 "z" "START" (lm-accent))
        (lm-depth 3 "b" "END" (lm-end-color)))
      (lm-map near-a near-b)
      (v-stack :width (lm-right-w) :gap (lm-gap)
        (lm-morph-block)
        (lm-tone-block)))))
